rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isAuthenticated() && getUserData().role == 'owner';
    }

    function isCustomer() {
      return isAuthenticated() && getUserData().role == 'customer';
    }

    function isOwnerOf(ownerId) {
      return isAuthenticated() && (request.auth.uid == ownerId || (isOwner() && getUserData().ownerId == ownerId));
    }

    // Users Collection (Username/Password authentication & approval system)
    match /users/{userId} {
      allow read, create: if true;
      allow update: if isAuthenticated();
      allow delete: if false; // Deletion prohibited for audit and security
    }

    // Dairy Profiles
    match /dairy_profiles/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customers Collection
    match /customers/{customerId} {
      // Owner can CRUD their customers; Customer can read their own customer profile
      allow read: if isAuthenticated() && (
        isOwner() || 
        resource.data.userId == request.auth.uid || 
        resource.data.phone == request.auth.token.phone_number
      );
      allow create, update, delete: if isOwner();
    }

    // Daily Milk Entries
    match /milk_entries/{entryId} {
      // Customer can read only their own milk entries; strictly NO write permission for customer
      allow read: if isAuthenticated() && (
        isOwner() || 
        resource.data.customerUserId == request.auth.uid || 
        resource.data.customerPhone == request.auth.token.phone_number
      );
      allow create, update, delete: if isOwner();
    }

    // Digital Customer Ledger (Khata)
    match /customer_ledgers/{ledgerId} {
      // Immutable ledger entries. Customer can only read their ledger.
      allow read: if isAuthenticated() && (
        isOwner() || 
        resource.data.customerUserId == request.auth.uid || 
        resource.data.customerPhone == request.auth.token.phone_number
      );
      allow create: if isOwner();
      allow update: if false; // Ledgers are immutable; adjustments must be made via new entries
      allow delete: if false;
    }

    // Monthly Bills
    match /monthly_bills/{billId} {
      allow read: if isAuthenticated() && (
        isOwner() || 
        resource.data.customerUserId == request.auth.uid || 
        resource.data.customerPhone == request.auth.token.phone_number
      );
      allow write: if isOwner();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isOwner() || 
        resource.data.customerUserId == request.auth.uid || 
        resource.data.customerPhone == request.auth.token.phone_number
      );
      // Customer can only create a pending payment intent record
      allow create: if isAuthenticated() && (
        isOwner() || 
        (isCustomer() && request.resource.data.status == 'PENDING')
      );
      // Only owner or trusted Cloud Function can verify / update payment status to PAID
      allow update: if isOwner();
      allow delete: if false;
    }

    // Dairy Expenses
    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isOwner();
    }

    // Immutable Audit Logs
    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strictly append-only
    }

    // App Settings
    match /app_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
  }
}

