rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can access dairy assets
    match /bills/{ownerId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }
    match /receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /dairy_logos/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}

